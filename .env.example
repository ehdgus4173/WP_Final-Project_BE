# What's Today — Backend environment variables.
# Copy to .env and fill in values. .env is gitignored.

# --- Server ---
NODE_ENV=development
PORT=3000
TZ=Asia/Seoul

# --- Database (Supabase Session pooler, port 5432) ---
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Auth (JWT in Authorization: Bearer header — no cookies) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- CORS (frontend origin(s), comma-separated) ---
FE_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- AI cron (Gemini) — only needed when cron runs ---
GEMINI_API_KEY=
# Bearer token Supabase pg_cron uses to call POST /api/cron/generate-issues
CRON_SECRET=
